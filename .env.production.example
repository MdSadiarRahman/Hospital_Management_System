APP_NAME="Meghna Clinic & Nursing Home"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://meghnaclinic.com
FORCE_HTTPS=true

APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Rotating daily application logs (14 days retention)
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Production MySQL Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mcnh_production
DB_USERNAME=mcnh_dbuser
DB_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_DATABASE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Encrypted, HttpOnly, SameSite Session Management
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Private Secure Storage for Diagnostic Medical Reports
FILESYSTEM_DISK=local

# Asynchronous Queue Processing
QUEUE_CONNECTION=database

# High-Performance Database Caching
CACHE_STORE=database

# Production Mail Service
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@meghnaclinic.com"
MAIL_FROM_NAME="Meghna Clinic & Nursing Home"

VITE_APP_NAME="${APP_NAME}"

